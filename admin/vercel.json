{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -- --configuration production",
  "outputDirectory": "dist/admin/browser",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://returnloadproject-api.onrender.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
